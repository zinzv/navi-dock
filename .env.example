# Copy to `.env` and fill in all values.

# Host-published port (mapped to container 7530)
SERVER_PORT=7530

# Optional — match host ./data owner (run on NAS: id <user>). Default: 1000
PUID=1000
PGID=1000

# Required for automatic access mode — set explicitly in the deployment environment.
# LAN-only domain used by the browser to detect whether the client is on the LAN.
# Path is fixed to /api/network/ping; protocol follows the current page.
# Example: LAN_PROBE_DOMAIN=lan.zeven.site
LAN_PROBE_DOMAIN=lan.zeven.site
